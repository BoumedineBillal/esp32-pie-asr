# ESP32-P4X (chip revision v3): 16 MB flash, PSRAM at 250 MHz, a 256 KB L2 cache with 128 B lines, -O2, a 32 KB main
# task, no task watchdog (a chunk keeps both cores busy)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_TASK_WDT_EN=n
# long file names on the SD card (the model's file name is not 8.3)
CONFIG_FATFS_LFN_HEAP=y
